#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in vec2 aTexCoord;
uniform mat4 view;
uniform vec3 offset;
uniform mat4 model;
uniform mat4 proj;
uniform float size;
out vec2 TexCoord;
out vec3 Normal;
out vec3 FragPos;
void main()
{
    TexCoord = aTexCoord;
    vec3 adj_pos = size * aPos;
    vec4 pos = vec4(adj_pos.x, adj_pos.y, adj_pos.z, 1.0);
	gl_Position = proj * view * model * pos;
    //FragPos = vec3(model * vec4(pos.x, pos.y, pos.z, 1.0));
    FragPos = vec3(model * vec4(aPos, 1.0));
    Normal = aNormal;
}
