#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec2 offset;
uniform mat4 view;
uniform mat4 model;
uniform mat4 proj;
void main()
{
    mat4 offset_model = model;
    offset_model[3] = vec4( offset, 0.0, 1.0);
	gl_Position = proj * view * offset_model * vec4(aPos, 1.0);
}

