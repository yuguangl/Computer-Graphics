#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;
layout (location = 2) in vec2 aTexCoord;
uniform mat4 view;
uniform mat4 model;
uniform mat4 proj;
uniform float size;
out vec2 TexCoord;
out vec3 Normal;
out vec3 FragPos;
void main()
{
    TexCoord = aTexCoord;
    gl_PointSize = 3.0;
    vec4 pos = vec4(size * aPos.x, size * aPos.y, size * aPos.z, 1.0);
	gl_Position = proj * view * pos;
    //FragPos = vec3(model * vec4(pos.x, pos.y, pos.z, 1.0));
    FragPos = vec3(model * vec4(aPos, 1.0));
    Normal = aNormal;
}
